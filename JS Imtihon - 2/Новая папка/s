/*
    File: s
    Generates random Uzbek phone numbers in format: +998 XX XXX XX XX
*/

function randInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

function twoDigits() {
    return String(randInt(0, 99)).padStart(2, '0');
}

function threeDigits() {
    return String(randInt(0, 999)).padStart(3, '0');
}

// operator: optional 2-digit string like "99". If omitted, chooses random between 90-99.
function generatePhone(operator) {
    const op = operator && /^\d{2}$/.test(operator) ? operator : String(randInt(90, 99));
    return `+998 ${op} ${threeDigits()} ${twoDigits()} ${twoDigits()}`;
}

// generate N numbers (default 1)
function generatePhones(n = 1, operator) {
    return Array.from({ length: n }, () => generatePhone(operator));
}

// Example usage:
console.log(generatePhone());           // single random number
console.log(generatePhones(5));         // 5 random numbers
console.log(generatePhones(3, '99'));   // 3 numbers with operator 99

// Export for use in other modules
if (typeof module !== 'undefined') module.exports = { generatePhone, generatePhones };